	"description": "Svelte 5 + Tailwind CSS component library styled after nqmcreative.com",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && svelte-kit sync && svelte-package && node scripts/strip-dist-tests.mjs && node scripts/generate-exports.mjs && node scripts/generate-registry.mjs && publint",
