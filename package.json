		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "prettier --check . && eslint . && node scripts/generate-exports.mjs --check && node scripts/generate-registry.mjs --check",
		"format": "prettier --write ."
	},
	"files": [
		"dist",
		"registry.json",
		"cli",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
